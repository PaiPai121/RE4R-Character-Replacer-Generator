<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>assets\re4r-replacer.ico</ApplicationIcon>
    <AssemblyName>RE4RCharacterReplacer</AssemblyName>
    <RootNamespace>RE4RCharacterReplacer</RootNamespace>
    <Version>0.4.7</Version>
    <FileVersion>0.4.7.0</FileVersion>
    <Product>RE4R Character Replacer Generator</Product>
    <Description>Portable launcher for the RE4R Character Replacer Generator.</Description>
  </PropertyGroup>
</Project>
